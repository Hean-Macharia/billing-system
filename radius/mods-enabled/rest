rest {
    connect_uri = "${RADIUS_API_BASE_URL}"
    connect_timeout = 4.0

    authorize {
        uri = "${..connect_uri}/api/v1/radius/auth"
        method = "post"
        body = "json"
        force_to = "json"
        timeout = 5.0
    }

    accounting {
        uri = "${..connect_uri}/api/v1/radius/accounting"
        method = "post"
        body = "json"
        timeout = 5.0
    }
}
