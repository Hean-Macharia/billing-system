server default {
    listen {
        type = auth
        ipaddr = *
        port = 1812
    }

    listen {
        type = acct
        ipaddr = *
        port = 1813
    }

    authorize {
        filter_username
        preprocess
        update control {
            REST-HTTP-Header := "X-RADIUS-API-Secret: ${RADIUS_API_SECRET}"
        }
        rest
        if (fail || invalid || reject || userlock || notfound) {
            reject
        }
    }

    authenticate {
        Auth-Type PAP {
            pap
        }
        Auth-Type CHAP {
            chap
        }
        Auth-Type MS-CHAP {
            mschap
        }
    }

    accounting {
        update control {
            REST-HTTP-Header := "X-RADIUS-API-Secret: ${RADIUS_API_SECRET}"
        }
        rest
        if (fail || invalid || reject || userlock || notfound) {
            reject
        }
    }
}
