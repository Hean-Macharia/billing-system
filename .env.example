# Application
APP_NAME=ISP Billing System
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=true
LOG_LEVEL=INFO
TIMEZONE=Africa/Nairobi
CURRENCY=KES
CORS_ORIGINS=http://localhost:3000,http://localhost:5500
ALLOWED_HOSTS=localhost,127.0.0.1,api
RATE_LIMIT_PER_MINUTE=100

# Database
MONGODB_URL=mongodb://mongodb:27017
DATABASE_NAME=isp_billing
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=10
MONGODB_MAX_IDLE_TIME_MS=60000

# JWT
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# RADIUS
RADIUS_HOST=radius
RADIUS_AUTH_PORT=1812
RADIUS_ACCT_PORT=1813
RADIUS_SECRET=replace-with-a-random-64-character-hex-secret
RADIUS_API_SECRET=replace-with-a-different-random-64-character-hex-secret
MIKROTIK_NAS_CIDR=192.168.88.1/32
RADIUS_BIND_IP=127.0.0.1

# M-Pesa Daraja
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=your-consumer-key
MPESA_CONSUMER_SECRET=your-consumer-secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=your-passkey
MPESA_CALLBACK_URL=https://example.com/api/v1/mpesa/callback

# Router and network
ROUTER_ENCRYPTION_KEY=replace-with-32-byte-key
ROUTER_USERNAME=admin
ROUTER_PASSWORD=change-me

# Scheduler
SCHEDULER_ENABLED=true
BILLING_GRACE_PERIOD_DAYS=3

# Notifications
AFRICAS_TALKING_USERNAME=
AFRICAS_TALKING_API_KEY=
AFRICAS_TALKING_SENDER_ID=

# Optional future integrations
SMS_SETTINGS={}
EMAIL_SETTINGS={}
MIKROTIK_API_SETTINGS={}
