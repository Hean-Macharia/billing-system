# App
APP_NAME=ISP Billing System
APP_VERSION=1.0.0
APP_ENV=production
DEBUG=false
LOG_LEVEL=INFO
TIMEZONE=Africa/Nairobi
CURRENCY=KES

# CORS / host security
CORS_ORIGINS=https://admin.example.com,https://portal.example.com,https://hotspot.example.com,https://api.example.com
ALLOWED_HOSTS=admin.example.com,portal.example.com,hotspot.example.com,api.example.com,api,localhost,127.0.0.1
RATE_LIMIT_PER_MINUTE=100

# MongoDB
MONGODB_URL=mongodb://mongodb:27017
DATABASE_NAME=isp_billing
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=10
MONGODB_MAX_IDLE_TIME_MS=60000

# JWT / auth
JWT_SECRET_KEY=replace-with-a-long-random-secret-at-least-32-chars
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# RADIUS
RADIUS_HOST=radius
RADIUS_AUTH_PORT=1812
RADIUS_ACCT_PORT=1813
RADIUS_SECRET=replace-with-a-random-64-character-hex-secret
RADIUS_API_SECRET=replace-with-a-different-random-64-character-hex-secret
MIKROTIK_NAS_CIDR=198.51.100.10/32
RADIUS_BIND_IP=10.8.0.1

# M-Pesa Daraja
MPESA_ENVIRONMENT=production
MPESA_CONSUMER_KEY=your-live-consumer-key
MPESA_CONSUMER_SECRET=your-live-consumer-secret
MPESA_SHORTCODE=123456
MPESA_PASSKEY=your-live-passkey
MPESA_CALLBACK_URL=https://api.example.com/api/v1/mpesa/callback

# Router / network
ROUTER_ENCRYPTION_KEY=replace-with-a-32-byte-key-or-long-random-value
ROUTER_USERNAME=admin
ROUTER_PASSWORD=StrongRouterPassword123

# Scheduler
SCHEDULER_ENABLED=true
BILLING_GRACE_PERIOD_DAYS=3

# Notifications
AFRICAS_TALKING_USERNAME=
AFRICAS_TALKING_API_KEY=
AFRICAS_TALKING_SENDER_ID=

# Optional integration payloads
SMS_SETTINGS={}
EMAIL_SETTINGS={}
MIKROTIK_API_SETTINGS={}
